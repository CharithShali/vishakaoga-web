# Copy this file to .env (same folder) and fill in your own values.
# .env holds passwords and keys, so it is never committed to GitHub.

NODE_ENV=development
PORT=5000

# MongoDB Atlas -> your cluster -> Connect -> Drivers -> copy the connection string.
# Put your database user's password in place of <db_password>, and keep /vishakaoga
# before the "?" so the data goes into a database with that name.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/vishakaoga?retryWrites=true&w=majority

# Long random text used to sign login tokens. Make one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# The first admin account, created by `npm run seed`.
# ADMIN_BRANCH is the branch code: KDY, BDW or COL.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=choose-a-strong-password
ADMIN_NAME=Your Name
ADMIN_BRANCH=COL

# Password for the test accounts made by `npm run seed:demo` (development only).
DEMO_PASSWORD=demo-pass-123

# Cloudinary (used from step 2: member photos)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
